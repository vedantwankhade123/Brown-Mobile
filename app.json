{
  "expo": {
    "name": "Brown AI",
    "slug": "brown-mobile",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./Assets/Brown-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./Assets/Brown-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brown.mobile",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Brown requires speech recognition for voice AI conversations.",
        "NSMicrophoneUsageDescription": "Brown requires microphone access to enable voice queries.",
        "NSCameraUsageDescription": "Brown uses the camera to scan the pairing QR code shown in Brown Desktop.",
        "NSLocalNetworkUsageDescription": "Brown requires local network access to synchronize with your desktop instance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Assets/Brown-adaptive.png",
        "backgroundColor": "#000000"
      },
      "package": "com.brown.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "REQUEST_INSTALL_PACKAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "versionCode": 17,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#00000000",
      "barStyle": "light-content"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000000",
          "borderColor": "#00000000",
          "barStyle": "light"
        }
      ],
      "./plugins/withSystemBarContrast.js",
      "./plugins/withLocalCompanionNetwork.js",
      "expo-font",
      "./plugins/withLlamaRN.js",
      "onnxruntime-react-native",
      [
        "expo-camera",
        {
          "cameraUsageDescription": "Brown uses the camera to scan the pairing QR code shown in Brown Desktop."
        }
      ]
    ]
  }
}
